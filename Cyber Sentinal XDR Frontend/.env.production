# Production build (npm run build) — overrides .env.
#
# Blank REACT_APP_BACKEND_URL forces config.ts to resolve BACKEND_URL to
# window.location.origin (SAME-ORIGIN). In the packaged product the backend
# serves these static files, so the API + Socket.IO are on the same origin the
# dashboard was loaded from — no hardcoded IP, works on any server.
REACT_APP_BACKEND_URL=
GENERATE_SOURCEMAP=false
