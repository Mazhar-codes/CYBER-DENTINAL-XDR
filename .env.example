# Cyber Sentinel XDR — environment configuration template
# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored — never commit it.

# --- MongoDB ---
# Atlas SRV connection string, or a local "mongodb://localhost:27017" if you
# are running MongoDB yourself (see README "Run MongoDB" section).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cyber_sentinel

# --- API auth ---
# Sent as the X-API-Key header by endpoint agents and demo/attack scripts.
XDR_API_KEY=changeme-dev-key
# HS256 JWT signing secret for the human-facing dashboard login — 32+ random chars.
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- SOAR ---
# Network interface name the isolate_host / unisolate_host actions toggle.
# Use your NIC's display name from `ipconfig` / Network Connections.
XDR_ISOLATE_INTERFACE=Ethernet

# --- Reports ---
# Where generated incident-report PDFs are written. Defaults to <repo>/reports
# if left unset — only set this if you want them somewhere else.
# XDR_REPORTS_DIR=D:\Cyber Sentinal\reports

# --- SMTP (optional — password-reset emails) ---
# Leave SMTP_ENABLED=false to skip email sending; forgot-password still works
# in dev mode (reset link is logged to the console + returned in the API response).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Cyber Sentinel XDR
FRONTEND_URL=http://localhost:3000
